/vendor
/node_modules
/.phpunit.cache
/.fleet
/.idea
/.vscode

# Environment and credentials
.env
.env.*
!.env.example
auth.json

# Runtime state
/storage/*.key
/storage/logs/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
!/storage/logs/.gitignore
!/storage/framework/cache/data/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore
/public/hot
/public/storage

# Persisted live user content must never enter Git
/public/upload/
/upload/

# Local database state
database/database.sqlite
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal

# Logs, reports, browser artifacts, scratch work
*.log
npm-debug.log
yarn-error.log
scratch_*
test-results/
playwright-report/
/screenshots/
/extract_test/
/package_out/
/.release-build/

# Generated deployment artifacts
/BDNSI_*.zip
/BDNSI_*.sql
/BDNSI_*.sha256

# AI/editor state is not application source
/.agents/
/.ai/
/.cursor/
/brain/

# public/build is intentionally tracked on the development branch until the
# release pipeline and frontend parity checks are fully stabilized.
