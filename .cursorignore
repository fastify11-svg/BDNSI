# Secrets
.env
.env.*
!.env.example
.deploy_key
.deploy_key.*
*.pem
*.key

# Dependencies/build output
vendor/
node_modules/
public/build/
playwright-report/
test-results/
coverage/

# Runtime/cache/log noise
storage/logs/
storage/framework/cache/
storage/framework/sessions/
storage/framework/views/
storage/app/backups/
bootstrap/cache/*.php
*.log
.phpunit.result.cache

# Legacy Antigravity workspace/history
# Active Cursor controls live under .cursor/. Historical files remain recoverable in Git.
.agents/

# Historical AI-agent state is noisy and often stale. Keep only the canonical handoff state
# in normal Cursor indexing; use Git/history explicitly if older evidence is genuinely needed.
.ai/*
!.ai/PROJECT_STATE.md

# Databases/backups/archives
*.sql
*.sqlite
*.sqlite3
*.dump
*.bak
*.zip
*.tar
*.tar.gz

# VCS/editor internals
.git/
.idea/
